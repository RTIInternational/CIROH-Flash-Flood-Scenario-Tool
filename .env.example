# CIROH Flash Flood Scenario Tool - Environment Configuration
# Copy this file to .env and adjust paths as needed for your local machine.

# Path to python.exe in the 'hydro-model' conda or virtual environment (where pysacsnow is installed)
HYDRO_MODEL_PY=C:\Users\domenicbrooks\.conda\envs\hydro-model\python.exe

# Optional override path to local NOAA Atlas 14 / Atlas 15 NetCDF precipitation frequency grid
ATLAS14_NC=D:\Capstone Project\Precip_Grids\Atlas_14\a14_hawaii.nc

# Active region profile name (matches a file in configs/regions/<name>.json or .yaml)
ACTIVE_REGION=hawaii
